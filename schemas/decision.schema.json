{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radio:schema:orchestrator-decision:v1",
  "title": "Radio Orchestrator Decision",
  "description": "Structured decision contract returned by the GPT-5.6 Sol orchestration layer. The schema makes the model's proposed next action machine-readable. Radio's policy engine remains authoritative and must independently validate the decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "generatedAt",
    "projectId",
    "workstreamId",
    "transactionId",
    "decision",
    "reason",
    "confidence",
    "authority",
    "evidenceBasis",
    "policyReferences",
    "blockers",
    "stateTransition",
    "cursorInstruction",
    "humanApproval",
    "wait",
    "terminal",
    "proposedStateUpdates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique Radio decision identifier, generated by the orchestrator or runtime."
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp for the decision."
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workstreamId": {
      "type": [
        "string",
        "null"
      ]
    },
    "transactionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "NO_ACTION",
        "WAIT",
        "LAUNCH_CURSOR",
        "REUSE_CURSOR",
        "REQUEST_HUMAN_APPROVAL",
        "ACCEPT_WORKSTREAM",
        "BLOCK_WORKSTREAM"
      ],
      "description": "The single proposed next orchestration action."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Concise reasoning for why this is the smallest legal next action."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "withinAutonomousAuthority",
        "humanApprovalRequired",
        "reason"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "AUTONOMOUS_ALLOWED",
            "HUMAN_APPROVAL_REQUIRED",
            "NO_ACTION_REQUIRED",
            "BLOCKED_BY_POLICY"
          ]
        },
        "withinAutonomousAuthority": {
          "type": "boolean"
        },
        "humanApprovalRequired": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceBasis": {
      "type": "array",
      "description": "Specific evidence used to make the decision. Keep this narrow and current.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PROJECT_STATE",
              "HUMAN_INSTRUCTION",
              "DECISION_LOG",
              "DEFERRED_BACKLOG",
              "CURSOR_REPORT",
              "TEST_RESULT",
              "BROWSER_EVIDENCE",
              "SOL_REVIEW",
              "OPUS_REVIEW",
              "GIT_STATE",
              "PR_STATE",
              "POLICY",
              "OTHER"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier, file path, agent ID, SHA, report ID, or other evidence reference."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "policyReferences": {
      "type": "array",
      "description": "Policy/decision IDs relevant to the proposed action.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "description": "Known blockers relevant to this decision. Empty if none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "class",
          "summary",
          "requiresHumanJudgment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "INFO"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "PRODUCT",
              "TEST",
              "BROWSER_EVIDENCE",
              "DOCUMENTATION",
              "COSMETIC_OR_HISTORICAL",
              "HUMAN_PRODUCT_DECISION",
              "INFRASTRUCTURE_OR_CONTROL_PLANE",
              "POLICY",
              "OTHER"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "requiresHumanJudgment": {
            "type": "boolean"
          }
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/runtimeState"
        },
        "to": {
          "$ref": "#/$defs/runtimeState"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cursorInstruction": {
      "description": "Cursor work order details. Must be null unless the decision is LAUNCH_CURSOR or REUSE_CURSOR. Cross-field enforcement is performed by Radio policy.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agentAction",
            "workType",
            "objective",
            "baseBranch",
            "expectedStartingSha",
            "requestedWork",
            "verificationCriteria",
            "expectedTerminalVerdicts",
            "maxRemediationPasses"
          ],
          "properties": {
            "agentAction": {
              "type": "string",
              "enum": [
                "REUSE_CURRENT_AGENT",
                "FRESH_ORDINARY_AGENT_REQUIRED",
                "FRESH_API_CREATED_PARENT_AUTO_REQUIRED"
              ]
            },
            "workType": {
              "type": "string",
              "enum": [
                "PRECHECK",
                "DESIGN",
                "IMPLEMENTATION",
                "VERIFICATION",
                "REVIEW",
                "REMEDIATION",
                "RECOVERY",
                "CLOSEOUT",
                "REPORT_REPAIR"
              ]
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "baseBranch": {
              "type": [
                "string",
                "null"
              ]
            },
            "expectedStartingSha": {
              "type": [
                "string",
                "null"
              ]
            },
            "expectedTerminalVerdicts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "maxRemediationPasses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "requestedWork": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "description": "Structured executable work Sol requests. This is the only Sol-authored text Radio may use for objective-authority prohibited-scope checks and P4 human-gated work detection. Must NOT include Radio guardrails, acceptance-only criteria, or reporting instructions."
            },
            "verificationCriteria": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "description": "Acceptance / verification criteria for the requested work. May mention prohibited scope to verify its ABSENCE. Never treated as executable work for authority or P4 evaluation."
            }
          }
        }
      ]
    },
    "humanApproval": {
      "description": "Human approval request. Must be populated for REQUEST_HUMAN_APPROVAL and null otherwise, subject to Radio policy validation.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalType",
            "summary",
            "requestedAction",
            "risk",
            "allowedChoices"
          ],
          "properties": {
            "approvalType": {
              "type": "string",
              "enum": [
                "OPEN_PR",
                "MERGE_PR",
                "PRODUCTION_DEPLOY",
                "START_RECOVERY_TRANSACTION",
                "PRODUCT_REQUIREMENT_CHANGE",
                "ARCHITECTURE_CHANGE",
                "PERSISTED_SCHEMA_CHANGE",
                "SCOPE_EXPANSION",
                "START_DEFERRED_WORK",
                "BUDGET_OVERRIDE",
                "RADIO_POLICY_CHANGE",
                "OTHER"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "requestedAction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "risk": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            },
            "allowedChoices": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "enum": [
                  "APPROVE",
                  "REJECT",
                  "REVISE"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "wait": {
      "description": "Wait instruction. Must be populated for WAIT and null otherwise, subject to Radio policy validation.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resumeOn",
            "reason",
            "activeAgentId",
            "condition"
          ],
          "properties": {
            "resumeOn": {
              "type": "string",
              "enum": [
                "AGENT_COMPLETION",
                "HUMAN_DECISION",
                "EXTERNAL_CONDITION",
                "TIME_OR_RETRY_WINDOW",
                "MANUAL_RESUME"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "activeAgentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "condition": {
              "type": [
                "string",
                "null"
              ],
              "description": "Concrete resume condition when applicable."
            }
          }
        }
      ]
    },
    "terminal": {
      "description": "Terminal-state description. Usually populated for ACCEPT_WORKSTREAM or BLOCK_WORKSTREAM, and null for nonterminal decisions.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "verdict",
            "summary"
          ],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "READY",
                "ACCEPTED",
                "BLOCKED",
                "FAILED"
              ]
            },
            "verdict": {
              "type": "string",
              "minLength": 1,
              "description": "Exact workstream-specific terminal verdict."
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          }
        }
      ]
    },
    "proposedStateUpdates": {
      "type": "object",
      "additionalProperties": false,
      "description": "Advisory state changes proposed by Sol. Radio validates and applies only allowed fields; the model may not directly alter hard policy.",
      "required": [
        "workstreamStatus",
        "transactionStatus",
        "terminalVerdict",
        "pendingHumanDecisionType"
      ],
      "properties": {
        "workstreamStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "transactionStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminalVerdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "pendingHumanDecisionType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "runtimeState": {
      "type": "string",
      "enum": [
        "IDLE",
        "PLANNING",
        "IMPLEMENTING",
        "WAITING_FOR_AGENT",
        "VERIFYING",
        "REVIEWING",
        "REMEDIATING",
        "READY_FOR_HUMAN",
        "WAITING_FOR_HUMAN",
        "ACCEPTED",
        "BLOCKED"
      ]
    }
  }
}
