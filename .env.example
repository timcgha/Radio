OPENAI_API_KEY=
RADIO_MODEL=gpt-5.6-sol
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com
# Live Cursor dispatch requires ALL THREE:
#   1) npm run pilot:bellhop:transmit  (--transmit)
#   2) CURSOR_EXECUTION_ENABLED=true
#   3) CURSOR_API_KEY present
# Fixture commands never transmit, even when these are set.
# Do not set CURSOR_EXECUTION_ENABLED=true until a human explicitly authorizes the first live transmission.
CURSOR_EXECUTION_ENABLED=false
# Explicit Cursor worker model (required for live create — never omit).
RADIO_CURSOR_WORKER_MODEL=composer-2
# Comma-separated approved cost-controlled worker models.
RADIO_CURSOR_APPROVED_MODELS=composer-2,composer-2.5,composer
# Premium / Other Models require RADIO_CURSOR_PREMIUM_MODEL_APPROVED=true
RADIO_CURSOR_PREMIUM_MODELS=claude-4.6-sonnet-thinking,claude-4-sonnet-thinking,claude-opus-4,gpt-5,o3
RADIO_CURSOR_PREMIUM_MODEL_APPROVED=false
# Global objective lease backend: memory (single process) | git-remote-ref (cross-workspace)
# Live multi-agent / multi-workspace runs MUST set git-remote-ref.
RADIO_OBJECTIVE_LEASE_BACKEND=git-remote-ref
RADIO_OBJECTIVE_LEASE_REMOTE=origin
