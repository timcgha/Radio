{
  "name": "radio",
  "version": "0.1.0",
  "description": "Radio — Autonomous Software Orchestration control plane (Phase 3)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pilot:bellhop": "tsx src/runtime/pilot-bellhop.ts",
    "pilot:bellhop:fixture": "tsx src/runtime/pilot-bellhop.ts --fixture",
    "pilot:bellhop:transmit": "tsx src/runtime/pilot-bellhop.ts --transmit",
    "pilot:bellhop:transmit:fixture": "tsx src/runtime/pilot-bellhop.ts --transmit-fixture",
    "pilot:bellhop:phase1-fixture": "tsx src/runtime/pilot-bellhop.ts --phase1-fixture",
    "pilot:bellhop:phase2:fixture": "tsx src/runtime/pilot-bellhop.ts --phase2-fixture",
    "pilot:bellhop:phase2": "tsx src/runtime/pilot-bellhop.ts --phase2",
    "pilot:bellhop:phase3:fixture": "tsx src/runtime/pilot-bellhop.ts --phase3-fixture",
    "pilot:bellhop:phase3": "tsx src/runtime/pilot-bellhop.ts --phase3",
    "pilot:cyber-assurance:phase3:fixture": "tsx src/runtime/pilot-cyber-assurance.ts",
    "pilot:bellhop:recover-invalid-report": "tsx src/runtime/pilot-bellhop.ts --recover-invalid-report",
    "pilot:bellhop:recover-invalid-report:fixture": "tsx src/runtime/pilot-bellhop.ts --recover-invalid-report-fixture"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
